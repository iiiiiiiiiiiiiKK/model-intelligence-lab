# ---------------------------------------------------------------------------
# Model Intelligence Lab — environment template
# Copy to `.env` and fill in real values. NEVER commit the filled `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=8790
HOST=127.0.0.1
NODE_ENV=development
# Absolute path to the SQLite database file. Defaults to <repo>/data/model-lab.db
MODEL_LAB_DB_PATH=

# ---------------------------------------------------------------------------
# Model providers
#
# The primary way to configure a provider is the in-app Settings → Providers
# screen: add a provider, paste its key, click "Test connection". Keys are
# encrypted with AES-256-GCM and stored in the local database; nothing needs a
# restart.
#
# The variables below are an OPTIONAL fallback for headless deployments (CI,
# containers, scripted provisioning). A key saved in the UI always wins over an
# environment value.
#
# Keys are never sent to the browser, never returned by the API, never logged
# and never included in reports.
# ---------------------------------------------------------------------------

# Any OpenAI-compatible chat completions endpoint.
# Used as the default credential for provider rows of kind `openai-compatible`
# that do not carry their own encrypted key.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1

# Optional dedicated credentials per built-in provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Provider used by the optional LLM-judge scorer and by the calibration script.
# Leave empty to disable judge-based scoring (rule scorers keep working).
JUDGE_PROVIDER=deepseek
JUDGE_MODEL=deepseek-chat

# Master key for encrypting provider credentials at rest.
# Leave empty: a random 32-byte key is generated once into data/.master-key.
# Set it (>= 32 characters) when you want the key to live in your secret manager
# instead of next to the database, e.g. when shipping a database backup.
MODEL_LAB_SECRET=

# Enables the community moderation endpoint (POST .../review). Unset = disabled.
ADMIN_TOKEN=
# ---------------------------------------------------------------------------
# Execution engine limits (safe defaults; tune to your budget)
# ---------------------------------------------------------------------------
EVAL_MAX_CONCURRENCY=3
EVAL_REQUEST_TIMEOUT_MS=60000
EVAL_MAX_RETRIES=2
EVAL_MAX_ITEMS_PER_RUN=200
EVAL_DEFAULT_BUDGET_USD=2

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Rate limiting for public API routes (per IP, per minute).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
# Max accepted JSON body size for API requests.
MAX_JSON_BODY_BYTES=262144
# Comma separated allow-list for outbound provider base URLs (SSRF guard).
# Empty means: allow only https:// hosts, block private/link-local ranges.
ALLOWED_PROVIDER_HOSTS=
# Set to true ONLY when the model provider is a self-hosted gateway on this
# machine or a private network (Ollama, vLLM, LM Studio, internal proxy).
# This permits http:// and loopback targets and therefore weakens SSRF
# protection. Leave it unset when calling public APIs.
ALLOW_LOOPBACK_PROVIDER=

# Public site origin, used for absolute share links in reports.
PUBLIC_SITE_URL=http://127.0.0.1:5199
